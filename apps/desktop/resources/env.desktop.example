# Inbox Flow desktop config (created on first launch)

# rdp / local = Blue Sender style. SMTP opens FROM THIS MACHINE (the RDP IP).
#               Needs Postgres + the local API on this box.
# remote      = login on Lightsail. Created-user contacts/campaigns/SMTP
#               stay in SQLite on this PC (%APPDATA%/Inbox Flow/workspace.db).
#               Platform admin (you) still uses the shared database.

INBOXFLOW_MODE=rdp

# Browser on the RDP session
LOCAL_PORT=__LOCAL_PORT__

# Filled when they Bind PC on /bind-pc (this VPS). Gmail open/click hits THIS machine.
BOUND_IP=
PUBLIC_URL=

# Unused in rdp/local mode. Prefer https:// when the Lightsail cert is valid.
REMOTE_APP_URL=__REMOTE_APP_URL__
# Same JWT_ACCESS_SECRET as Lightsail so this PC can verify cloud login tokens.
CLOUD_JWT_ACCESS_SECRET=
# Set to 1 only if Lightsail uses a self-signed HTTPS cert.
INBOXFLOW_TLS_INSECURE=0

# --- rdp / local ---
API_PORT=__API_PORT__
DATABASE_URL=postgresql://inboxflow:inboxflow@127.0.0.1:5432/inboxflow
JWT_ACCESS_SECRET=__JWT_ACCESS__
JWT_REFRESH_SECRET=__JWT_REFRESH__
ENCRYPTION_KEY=__ENCRYPTION_KEY__
WEBHOOK_SECRET=__WEBHOOK_SECRET__
COOKIE_SECURE=false
RUN_WORKERS=true
