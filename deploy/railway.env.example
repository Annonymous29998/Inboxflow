# Inbox Flow — Railway @inboxflow/api variables template
# Copy to railway.env (gitignored), fill secrets, paste into Railway.

NODE_ENV=production
API_PORT=3001
APP_NAME=Inbox Flow

APP_URL=https://YOUR-VERCEL-APP.vercel.app
API_URL=https://YOUR-RAILWAY-API.up.railway.app
CORS_ORIGIN=https://YOUR-VERCEL-APP.vercel.app
WEBHOOK_BASE_URL=https://YOUR-RAILWAY-API.up.railway.app

DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.xxxxx.supabase.co:5432/postgres?sslmode=require

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
ENCRYPTION_KEY=

# Not used for campaign sending — add SMTP in the app (Settings → SMTP Manager)
SMTP_HOST=json
SMTP_PORT=465
SMTP_SECURE=true
SMTP_FROM=noreply@inboxflow.io
EMAIL_FROM_ADDRESS=noreply@inboxflow.io
EMAIL_FROM_NAME=Inbox Flow

ALLOW_PUBLIC_REGISTER=false
COOKIE_SECURE=true
WEBHOOK_SECRET=
